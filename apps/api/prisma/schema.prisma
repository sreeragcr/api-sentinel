
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApiProtocol {
  REST
  GRAPHQL
  GRPC

  @@map("api_protocol")
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS

  @@map("http_method")
}

model Workspace {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(120)
  slug        String  @unique @db.VarChar(60)
  description String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects Project[]

  @@map("workspaces")
}

model Project {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  name        String  @db.VarChar(120)
  slug        String  @db.VarChar(60)
  description String? @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  apiDefinitions ApiDefinition[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("projects")
}

model ApiDefinition {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @map("project_id") @db.Uuid
  name        String      @db.VarChar(120)
  description String?     @db.VarChar(500)
  protocol    ApiProtocol

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  restEndpoints RestEndpoint[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("api_definitions")
}

model RestEndpoint {
  id              String     @id @default(uuid()) @db.Uuid
  apiDefinitionId String     @map("api_definition_id") @db.Uuid

  name        String      @db.VarChar(120)
  description String?     @db.VarChar(500)
  method      HttpMethod
  path        String      @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  apiDefinition ApiDefinition @relation(fields: [apiDefinitionId], references: [id], onDelete: Cascade)

  @@unique([apiDefinitionId, method, path])
  @@index([apiDefinitionId])
  @@map("rest_endpoints")
}
